# Brahmo Citation Safety Engine Environment Variables Template
# Copy this file to .env or .env.local and populate with your actual keys

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Indian Kanoon API Token
INDIAN_KANOON_API_KEY=your-indian-kanoon-api-token

# Mistral API Keys (numbered pool — the app rotates across these and fails
# over to the next key when one is rate limited). Add as many as you have.
MISTRAL_API_KEY_1=your-mistral-key-1
MISTRAL_API_KEY_2=your-mistral-key-2

# Next.js API configuration (Frontend uses this to connect to the FastAPI backend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
