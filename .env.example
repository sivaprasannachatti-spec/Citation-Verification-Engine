# Brahmo Citation Safety Engine Environment Variables Template
# Copy this file to .env or .env.local and populate with your actual keys

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Indian Kanoon API Token
INDIAN_KANOON_API_KEY=your-indian-kanoon-api-token

# Google Gemini API Keys (supports comma-separated list for rotation/retry)
GEMINI_API_KEY=key_1,key_2

# Groq API Keys (supports comma-separated list for rotation/retry fallback)
GROQ_API_KEY=key_1,key_2

# Next.js API configuration (Frontend uses this to connect to the FastAPI backend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
